# Project 3: Number Guessing Game

secret_text = input("Player 1, enter the secret number: ").strip()

if not secret_text.isdigit():
    print("Invalid input. Ending game.")
else:
    secret = int(secret_text)

    max_text = input("Enter the maximum number of guesses: ").strip()

    if not max_text.isdigit() or int(max_text) < 1:
        print("Invalid input. Ending game.")
    else:
        max_guesses = int(max_text)
        total = 0
        count = 0
        won = False
        invalid_input = False

        for k in range(1, max_guesses + 1):
            guess_text = input(f"Guess {k} of {max_guesses}: ").strip()

            if not guess_text.isdigit():
                print("Invalid input. Ending game.")
                invalid_input = True
                break

            guess = int(guess_text)
            total = total + guess
            count = count + 1

            if guess > secret:
                print("Too high.")
            elif guess < secret:
                print("Too low.")
            else:
                print(f"You got it! Guesses used: {k}")
                won = True

            average = total / count
            print(f"Average guess so far: {average:.2f}")

            if won:
                break

        if not won and not invalid_input:
            print(f"Out of guesses. The number was {secret}.")
